# Local development uses embedded Postgres (PGlite) stored in ./.data — nothing to install.
# In production set a real Postgres URL, e.g. from Neon: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=pglite://.data/pglite

# Generate with: npx @better-auth/cli secret   (any long random string works)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Optional: without it, emails are printed to the terminal.
RESEND_API_KEY=
EMAIL_FROM=Echoboard <onboarding@resend.dev>

# Stripe (test mode). Billing stays disabled until STRIPE_SECRET_KEY is set.
# Dashboard → Developers → API keys → Secret key (sk_test_…). Live keys are refused.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint you create in the dashboard (whsec_…).
STRIPE_WEBHOOK_SECRET=
